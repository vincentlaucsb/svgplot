{
  "name": "svgplot",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:setup": "npm ci --prefix docs && node docs/install-renderer.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:test": "playwright test --config docs/playwright.config.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0"
  }
}
